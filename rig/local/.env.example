# rig/local/.env — config for the local Titan-only docker rig.
#
# Copy this file to `.env` (which is gitignored) and edit as needed:
#   cp .env.example .env
#
# `task dev:titan` reads `.env` via `docker compose --env-file .env`.
# All values below are DEV-ONLY samples — fine for a throwaway rig, NOT for
# anything reachable from outside your laptop.

# Postgres password for the `titan` role. Flyway + JDBI both use it.
# Regenerate with `openssl rand -hex 16` for anything non-toy.
POSTGRES_PASSWORD=titan-dev-only

# Credential envelope KEK (AES-256, base64). Sealed credential payloads in
# titan.credentials are unsealed with this key.
# DEV-ONLY sample — regenerate with:
#   openssl rand -base64 32
TITAN_KEK=changeme-dev-only-do-not-use-in-production-XXXXXXX=
