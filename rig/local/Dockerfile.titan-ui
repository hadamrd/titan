# titan-ui multi-stage build.
#
# Stage 1: build the React SPA with pnpm (Vite + tsc check).
# Stage 2: serve the dist/ tree with nginx, proxying /api + /q to titan-server.
#
# Post #898: there are NO `VITE_*` build-args. The OIDC issuer / public URL
# come from titan-server's `GET /api/v1/system/ui-config` at runtime, and the
# API base is same-origin (nginx proxies /api). One image, N rigs.

# ── Stage 1: build ────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /src

# Pin pnpm explicitly — lockfileVersion 9.0 requires pnpm v9+, and corepack's
# floating "latest pnpm" on node 20 trips an ERR_UNKNOWN_BUILTIN_MODULE
# (pnpm 11 imports node builtins added in node 22).
RUN npm install -g pnpm@10.13.1

# Manifest + lockfile first for layer caching: only re-install deps when these
# files change, not when arbitrary .tsx files do.
COPY titan-ui/package.json titan-ui/pnpm-lock.yaml titan-ui/.npmrc titan-ui/.pnpmfile.cjs ./
RUN pnpm install --frozen-lockfile

# Now the rest of the source tree.
COPY titan-ui/ ./

# Markdown docs bundled by the /docs viewer at build time via Vite `?raw`
# imports (src/lib/docsCatalog.ts hops up 3 levels to the repo root).
# Mirror that hop here: vite resolves `../../../docs/X.md` from
# /src/src/lib/, so the files must live at /src/docs/ and
# /src/.claude/skills/add-pdl-step/. Compose's build context is the repo
# root (../..), so these COPYs work.
COPY docs/ ../docs/
COPY .claude/skills/add-pdl-step/ ../.claude/skills/add-pdl-step/

RUN pnpm build

# ── Stage 2: serve ────────────────────────────────────────────────────────
FROM nginx:alpine

# nginx config — SPA fallback + /api,/q reverse-proxy to titan-server.
COPY rig/local/nginx.conf /etc/nginx/conf.d/default.conf

# Drop the built SPA into the default web root.
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80
