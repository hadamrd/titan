{
  "realm": "titan-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "READ_JOB",       "composite": false },
      { "name": "TRIGGER_BUILD",  "composite": false },
      { "name": "EDIT_PIPELINE",  "composite": false },
      { "name": "APPROVE_GATE",   "composite": false },
      { "name": "ADMIN",          "composite": false }
    ]
  },
  "clients": [
    {
      "clientId": "titan-server",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-titan-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "titan-server",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "realmRoles": ["READ_JOB", "TRIGGER_BUILD", "EDIT_PIPELINE", "APPROVE_GATE"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "viewer", "temporary": false }
      ],
      "realmRoles": ["READ_JOB"]
    }
  ]
}
