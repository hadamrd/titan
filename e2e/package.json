{
  "name": "titan-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Titan end-to-end Playwright harness (design/43). Two axes: UI flows through Chromium, white-box engine assertions through the TitanGraphApiAction DAG JSON.",
  "type": "module",
  "scripts": {
    "build:fixtures": "node fixtures/build-fixtures.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:scenarios": "playwright test scenarios.spec.ts",
    "report": "playwright show-report",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@playwright/test": "^1.49.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "js-yaml": "^4.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
