# e2e/.env.layer2.example — the Layer-2 / independent-verification env (#1241).
#
# Spec 54 (54-r2-independent-verify.spec.ts) and spec 49 (49-nexus-publish.spec.ts)
# are the only two e2e specs that read artifact bytes STRAIGHT FROM THE OBJECT
# STORE (R2 / Nexus) instead of via Titan's API. They `test.skip()` until their
# rig + creds are wired. This file documents every var, with the EXACT names the
# specs read, so the artifact-publish path stops being "green by accident".
#
# DO NOT put real secrets here — this file is committed. Copy it to a gitignored
# `e2e/.env.layer2`, fill it, and `set -a; . ./.env.layer2; set +a` before
# running, OR (preferred) let the task targets source the secrets from Infisical
# at runtime:
#   task e2e:layer2   # R2  — spec 54 (sources R2_* from Infisical staging)
#   task e2e:nexus    # Nexus — spec 49 (boots local Nexus, dev creds)
#
# ─────────────────────────────────────────────────────────────────────────────
# Common
# ─────────────────────────────────────────────────────────────────────────────

# The opt-in switch. BOTH specs skip unless this is set (never run on plain
# local dev). `task e2e:layer2` / `task e2e:nexus` set it for you.
LAYER2_RIG_AVAILABLE=1

# Which rig the build is driven against. Spec 54 (R2) defaults to the public k3s
# rig whose worker is provisioned to WRITE to R2 (rig/k3s/rig-values.yaml). Spec
# 49 (Nexus) targets the LOCAL rig you boot with the Nexus compose, so
# `task e2e:nexus` sets TITAN_RIG_URL=http://localhost:18080.
# TITAN_RIG_URL=https://titan.test.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Spec 54 — Cloudflare R2 (independent S3 read)
# ─────────────────────────────────────────────────────────────────────────────
# The spec reads TITAN_R2_* (and also accepts the chart's ARTIFACTS_* names).
# `task e2e:layer2` resolves these from Infisical `staging` when absent:
#   R2_ACCESS_KEY_ID     -> TITAN_R2_ACCESS_KEY
#   R2_SECRET_ACCESS_KEY -> TITAN_R2_SECRET_KEY
#   R2_ACCOUNT_ID        -> TITAN_R2_ENDPOINT = https://<account>.r2.cloudflarestorage.com
# (set INFISICAL_TOKEN + INFISICAL_PROJECT_ID for that path).

# Required (the spec skips cleanly if any is missing):
TITAN_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
TITAN_R2_ACCESS_KEY=<r2-access-key-id>
TITAN_R2_SECRET_KEY=<r2-secret-access-key>
# Optional — these are the defaults the spec assumes:
TITAN_R2_BUCKET=titan-artifacts
TITAN_R2_REGION=auto

# ─────────────────────────────────────────────────────────────────────────────
# Spec 49 — Nexus raw hosted (independent HTTP GET)
# ─────────────────────────────────────────────────────────────────────────────
# `task e2e:nexus` boots rig/local/docker-compose.nexus.yml (dev creds below),
# bootstraps the raw `titan-artifacts` repo, and exports these for you. Override
# only if you point at a different Nexus.

NEXUS_URL=http://localhost:8085
NEXUS_REPOSITORY=titan-artifacts
NEXUS_USERNAME=admin
NEXUS_PASSWORD=admin123
# Repo write policy — drives the spec's adversarial re-publish assertion:
#   allow       second PUT 2xx, latest bytes win (snapshot-like) [default]
#   allow_once  second PUT 4xx, original bytes remain (release/immutable)
#   deny        second PUT 4xx, original bytes remain
NEXUS_WRITE_POLICY=allow
